--- a/src/runtime/platform.cpp
+++ b/src/runtime/platform.cpp
@@ -20,7 +20,7 @@
 #include <mach/mach_time.h>
 #include <mach/thread_policy.h>
 #include <pthread.h>
-#else
+#elif defined(__linux__)
 #include <sys/prctl.h>
 #endif
 
@@ -113,12 +113,14 @@ uint64_t MonotonicNs() {
 }
 
 void SleepUntilNs(uint64_t t) {
+#if defined(__linux__)
   // The default slack (50 us) would delay every wake-up by about that.
   static thread_local bool slack_set = false;
   if (!slack_set) {
     prctl(PR_SET_TIMERSLACK, 1UL, 0UL, 0UL, 0UL);
     slack_set = true;
   }
+#endif
   timespec ts;
   ts.tv_sec = time_t(t / 1000000000u);
   ts.tv_nsec = long(t % 1000000000u);
