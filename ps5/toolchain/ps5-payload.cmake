# SPDX-License-Identifier: GPL-3.0-or-later
# Minimal, compile-only PS5 C++ fixture toolchain. Adapted from Encore tools/ps5.cmake.
# This toolchain does not prove that the reFrozen runtime links or runs on PS5.
if(NOT DEFINED ENV{PS5_PAYLOAD_SDK} OR "$ENV{PS5_PAYLOAD_SDK}" STREQUAL "")
  message(FATAL_ERROR "PS5_PAYLOAD_SDK is required for PS5 cross compilation")
endif()
set(_ps5_sdk "$ENV{PS5_PAYLOAD_SDK}")
if(NOT EXISTS "${_ps5_sdk}/target/include")
  message(FATAL_ERROR "PS5 SDK target/include missing: check PS5_PAYLOAD_SDK")
endif()
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_COMPILER clang-18)
set(CMAKE_CXX_COMPILER clang++-18)
set(CMAKE_ASM_COMPILER clang-18)
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_ASM_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR llvm-ar-18)
set(CMAKE_RANLIB llvm-ranlib-18)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_C_FLAGS_INIT "-isysroot \"${_ps5_sdk}\" -isystem \"${_ps5_sdk}/target/include\" -fno-stack-protector -fno-plt -femulated-tls -fvisibility-nodllstorageclass=default")
set(CMAKE_CXX_FLAGS_INIT "-isystem \"${_ps5_sdk}/target/include/c++/v1\" ${CMAKE_C_FLAGS_INIT} -fexceptions -fcxx-exceptions")
set(CMAKE_ASM_FLAGS_INIT "${CMAKE_C_FLAGS_INIT}")
